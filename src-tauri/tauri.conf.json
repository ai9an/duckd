{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "duckd",
  "version": "0.1.0",
  "identifier": "audiomgr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "duckd",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      },
      {
        "label": "hud",
        "title": "duckd mixer",
        "url": "index.html?view=hud",
        "width": 550,
        "height": 650,
        "center": true,
        "visible": false,
        "focus": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Global hotkey volume presets and per-app audio mixer.",
    "longDescription": "duckd is a lightweight desktop audio manager with global volume presets, a per-application mixer, and a quick mixer HUD.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
